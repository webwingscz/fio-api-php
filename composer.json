{
  "name": "webwingscz/fio-api-php",
  "type": "library",
  "description": "Fio API PHP implemention",
  "keywords": [
    "fio",
    "banking",
    "api"
  ],
  "homepage": "https://github.com/webwingscz/fio-api-php",
  "license": "MIT",
  "authors": [
    {
      "name": "Martin Hujer",
      "email": "mhujer@gmail.com",
      "homepage": "https://www.martinhujer.cz/",
      "role": "Developer"
    },
    {
      "name": "Jiří Dorazil",
      "email": "dorazil@webwings.cz",
      "homepage": "https://www.webwings.cz/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*",
    "ext-xmlwriter": "*",
    "composer/ca-bundle": "^1.5",
    "guzzlehttp/guzzle": "^7.0 || ^8.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "FioApi\\": "src/FioApi"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FioApi\\": "tests/FioApi"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "ci": [
      "@security",
      "@phpstan",
      "@phpcs",
      "@test"
    ],
    "security": "composer audit --locked --no-dev",
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover=build/logs/clover.xml",
    "phpcs": "phpcs --standard=PSR12 src && phpcs --standard=PSR12 tests",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G"
  }
}
